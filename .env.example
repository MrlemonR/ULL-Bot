PROFILE=desktop                 # desktop | laptop (Faz 6'da devreye girer)

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=changeme-local-key
LITELLM_MODEL=chat-default       # config/litellm.<profile>.yaml içindeki model_name

OPENROUTER_API_KEY=

# --- Faz 3: çoklu sağlayıcı ---
# Hepsi ücretsiz, kredi kartı istemiyor. Anahtarı olmayan sağlayıcı
# otomatik olarak aday listesinden düşer (401 almanın anlamı yok).
GROQ_API_KEY=                   # https://console.groq.com/keys
GEMINI_API_KEY=                 # https://aistudio.google.com/apikey
CEREBRAS_API_KEY=               # (henüz routing.yaml'da yok)
MISTRAL_API_KEY=

# --- Faz 5+ ---
OLLAMA_HOST=http://localhost:11434
ENABLE_LOCAL=true               # laptop profilinde false

# --- Faz 2 (araçlar ve güvenlik) ---
# Ajanın çalışma dizini. Boş bırakılırsa ~/Projects (yoksa ev dizini).
# Hangi dizinlere erişilebileceği config/workspace.yaml'da.
WORKSPACE_ROOT=
# true iken yazma potansiyeli olan komutlar çalıştırılmaz, sadece raporlanır.
# Salt okunur komutlar normal çalışır.
DRY_RUN=true
# Ajan bu kadar adımda bitiremezse "devam edeyim mi?" diye sorar.
MAX_AGENT_STEPS=15
# Onay diyaloğu cevapsız kalırsa bu süre sonunda REDDEDİLMİŞ sayılır.
APPROVAL_TIMEOUT_SECONDS=300
# Araç çıktısı bu uzunluğu aşarsa ortadan kırpılarak modele verilir.
TOOL_OUTPUT_LIMIT=4000
SHELL_TIMEOUT_SECONDS=30

# --- Faz 3 (kota) ---
# Kotanın bu oranı acil işler için saklanır: kalan bu eşiğin altına inince
# sağlayıcı 429 beklemeden elenir. 0 ise config/quotas.yaml'daki değer geçerli.
RESERVE_RATIO=0.1
# 429 alındığında bir tur içinde en fazla kaç farklı sağlayıcı denenir.
MAX_PROVIDER_ATTEMPTS=3

# Boş bırakılırsa platformdirs ile otomatik hesaplanır (bkz. DECISIONS.md)
DB_PATH=

# --- Faz 8 (mail / IMAP) ---
# Arka plan senkron aralığı, saniye. 0 = otomatik senkron kapalı, sadece
# UI'daki "Senkronla" düğmesi ve `sync_mail` aracı çeker.
MAIL_SYNC_INTERVAL_SECONDS=300
# Bir senkronda klasör başına en fazla kaç YENİ mesaj indirilir. İlk
# senkronda kutunun tamamını çekmemek için var.
MAIL_SYNC_LIMIT=200
# Gövde bu boyutu aşarsa kırpılarak saklanır (önbellek şişmesin), byte.
MAIL_BODY_LIMIT=200000
# Yeni mail geldiğinde kural tabanlı sınıflandırıcı otomatik çalışsın mı?
# (LLM'e sorma ayrı ve elle: UI'daki "Kararsızları modele ayırt" düğmesi.)
MAIL_AUTO_CATEGORIZE=true
#
# IMAP PAROLASI BURAYA YAZILMAZ. Hesap UI'dan (Ayarlar → Mail) eklenir,
# parola sistem anahtarlığına (libsecret) gider; anahtarlık yoksa veri
# dizininde 0600 bir dosyaya. Gmail için normal parola değil UYGULAMA
# PAROLASI gerekiyor: myaccount.google.com → Güvenlik → Uygulama parolaları.

# --- Faz 8 (takvim ve bildirim) ---
# Hatırlatıcı döngüsünün kontrol aralığı, saniye. Bildirimin gecikme payı
# en fazla bu kadar olur.
CALENDAR_POLL_SECONDS=30
# Masaüstü bildirimleri (dunst/mako/GNOME — freedesktop bildirim protokolü).
NOTIFICATIONS_ENABLED=true
# Yeni etkinliklerin varsayılan hatırlatması: kaç dakika önce. -1 = kapalı.
DEFAULT_REMINDER_MINUTES=10

# --- Faz 8 (masaüstü uygulaması) ---
# Süpervizörün başlatacağı portlar. LITELLM_BASE_URL ile tutarlı olmalı.
API_PORT=8080
LITELLM_PORT=4000
# Servisler bu süre içinde ayağa kalkmazsa açılış ekranı hata gösterir.
SERVICE_STARTUP_TIMEOUT=90
WINDOW_WIDTH=1360
WINDOW_HEIGHT=880


# --- Faz 9: web aramasi (ISTEGE BAGLI) ---
# Bos birakilirsa arama DuckDuckGo kazimasiyla yapilir. Ucretsiz ve kurulum
# istemiyor, AMA arama motorlari sik istekte captcha/"anomaly" sayfasi
# donduruyor ve arastirma yarida kesilebiliyor.
#
# Asagidakiler SIRAYLA denenir; ilk sonuc veren kazanir, hepsi bosse kazima.
#
# 1) SearXNG — kendi makinende calisan meta-arama. Kota yok, anahtar yok,
#    sorgu ucuncu tarafa gitmiyor. Kurulum: docs/SEARXNG.md
#    `settings.yml` icinde `search.formats` listesinde `json` OLMALI.
SEARXNG_URL=
#
# 2) Tavily — ayda 1000 kredi, her ay yenileniyor, kart istemiyor.
#    https://app.tavily.com/ (Google/GitHub ile giris) → API Keys
TAVILY_API_KEY=
#
# 3) Brave — ayda 2000 sorgu, AMA kayitta kredi karti isteyebiliyor.
#    https://api-dashboard.search.brave.com/
BRAVE_API_KEY=
