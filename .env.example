PROFILE=desktop                 # desktop | laptop (Faz 6'da devreye girer)

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=changeme-local-key
LITELLM_MODEL=chat-default       # config/litellm.<profile>.yaml içindeki model_name

OPENROUTER_API_KEY=

# --- Faz 3: çoklu sağlayıcı ---
# Hepsi ücretsiz, kredi kartı istemiyor. Anahtarı olmayan sağlayıcı
# otomatik olarak aday listesinden düşer (401 almanın anlamı yok).
GROQ_API_KEY=                   # https://console.groq.com/keys
GEMINI_API_KEY=                 # https://aistudio.google.com/apikey
CEREBRAS_API_KEY=               # (henüz routing.yaml'da yok)
MISTRAL_API_KEY=

# --- Faz 5+ ---
OLLAMA_HOST=http://localhost:11434
ENABLE_LOCAL=true               # laptop profilinde false

# --- Faz 2 (araçlar ve güvenlik) ---
# Ajanın çalışma dizini. Boş bırakılırsa ~/Projects (yoksa ev dizini).
# Hangi dizinlere erişilebileceği config/workspace.yaml'da.
WORKSPACE_ROOT=
# true iken yazma potansiyeli olan komutlar çalıştırılmaz, sadece raporlanır.
# Salt okunur komutlar normal çalışır.
DRY_RUN=true
# Ajan bu kadar adımda bitiremezse "devam edeyim mi?" diye sorar.
MAX_AGENT_STEPS=15
# Onay diyaloğu cevapsız kalırsa bu süre sonunda REDDEDİLMİŞ sayılır.
APPROVAL_TIMEOUT_SECONDS=300
# Araç çıktısı bu uzunluğu aşarsa ortadan kırpılarak modele verilir.
TOOL_OUTPUT_LIMIT=4000
SHELL_TIMEOUT_SECONDS=30

# --- Faz 3 (kota) ---
# Kotanın bu oranı acil işler için saklanır: kalan bu eşiğin altına inince
# sağlayıcı 429 beklemeden elenir. 0 ise config/quotas.yaml'daki değer geçerli.
RESERVE_RATIO=0.1
# 429 alındığında bir tur içinde en fazla kaç farklı sağlayıcı denenir.
MAX_PROVIDER_ATTEMPTS=3

# Boş bırakılırsa platformdirs ile otomatik hesaplanır (bkz. DECISIONS.md)
DB_PATH=
